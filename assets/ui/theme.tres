[gd_resource type="Theme" load_steps=10 format=3]

; Halloween Critter Royale - UI theme.
; Paleta (plan): negro azulado #0E1220, violeta apagado #6B4E8E,
; naranja calabaza #E8862E, verde espectral #6FA35A, crema lunar #F3E9C8.
; Prohibidos neon/cian: tools/audit_palette.py lo verifica.
; Fase 6: marcos dorados nine-patch (tools/gen_ui_frames.py) + fuentes OFL
; Almendra (cuerpo), Cinzel (botones) y Creepster (titulos); las tres con
; cobertura ES completa (verificado con cmap: ñ tildes ¿ ¡).

[ext_resource type="FontFile" path="res://assets/ui/fonts/Almendra-Regular.ttf" id="font_body"]
[ext_resource type="FontFile" path="res://assets/ui/fonts/Cinzel.ttf" id="font_btn"]
[ext_resource type="FontFile" path="res://assets/ui/fonts/Creepster-Regular.ttf" id="font_title"]
[ext_resource type="Texture2D" path="res://assets/ui/ui_frame_panel.png" id="frame_panel"]
[ext_resource type="Texture2D" path="res://assets/ui/ui_frame_btn.png" id="frame_btn"]

