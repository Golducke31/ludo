# Godot editor cache — regenerable (se recrea al abrir el proyecto).
.godot/

# Datos de trabajo del asistente (notas/memoria del proyecto): no forman parte
# del juego y no deben publicarse.
.workbuddy-ai/

# Salidas del horneado de relieve: TODAS las texturas van embebidas en los .glb
# (ver BLENDER_RELIEF.md). Regenerar los PNG sueltos con tools/blender_relief.py.
assets/models/baked/

# Texturas extraidas por el importador GLB (embedded_image_handling=1): el .scn
# las referencia por res://assets/models/<base>_<map>_<canal>.png y Godot las
# recrea al reimportar. No son fuente; se regeneran localmente como baked/.
assets/models/*.png
assets/models/*.png.import

# Ruido de sistema / editores
.DS_Store
Thumbs.db
*.tmp
*~
